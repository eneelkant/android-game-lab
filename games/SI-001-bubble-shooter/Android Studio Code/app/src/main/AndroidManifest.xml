<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.burhanstore.bubblereward" >

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission
        android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.Ad_ID" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name="com.burhanstore.bubblereward.AppController"
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_icon"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:targetApi="m" >
        <activity
            android:name="com.burhanstore.bubblereward.activity.MyprofileActivity"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.NotificationA"
            android:exported="false"
            android:label="@string/notifications" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.PrvacyA"
            android:exported="false"
            android:label="@string/privacy_policy" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.ContactA"
            android:exported="false"
            android:label="@string/contact_us" />
        <activity
            android:name="com.burhanstore.bubblereward.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.LeaderA"
            android:exported="false"
            android:label="@string/Leaderboard" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.EditA"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.MyProfile"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.SpinA"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.RedeemA"
            android:exported="false"
            android:label="@string/Redeem" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.includ.ResetPasActivity"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.TransactionsH"
            android:exported="false"
            android:label="@string/transactions_history" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.EarningHistoryA"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.WalletA"
            android:exported="false"
            android:label="@string/Wallet" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.ReferAndEarnA"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.includ.Signup"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.includ.Login"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.includ.LoginView"
            android:exported="false" />
        <activity
            android:name="com.burhanstore.bubblereward.activity.SplashActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="AYET_APP_KEY"
            android:value="@string/ayet_app_key" />
        <meta-data
            android:name="com.startapp.sdk.APPLICATION_ID"
            android:value="555555" />
        <meta-data
            android:name="android.app.lib_name"
            android:value="" />
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_ads_id" />

        <activity
            android:name="com.vungle.warren.ui.VungleActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <provider
            android:name="com.vungle.warren.utility.VungleProvider"
            android:authorities="${applicationId}.vungle-provider"
            android:exported="false" />
    </application>

</manifest>