<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/ExitDialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            app:cardBackgroundColor="@color/New_color1"
            app:cardCornerRadius="30dp"
            card_view:cardPreventCornerOverlap="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_40sdp"
                android:orientation="vertical">

                <!--Title & Description-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10sdp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/title_text_points"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/public_semibold"
                        android:gravity="center"
                        android:maxLines="3"
                        android:singleLine="false"
                        android:text="Congratulation"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_18ssp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/points"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/public_medium"
                        android:gravity="center"
                        android:singleLine="false"
                        android:text=""
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14ssp"
                        android:visibility="visible" />

                </LinearLayout>

                <!--Done & Cancel buttons-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/cancel_btn_video_ads"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_37sdp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_7sdp"
                        android:layout_weight="50"
                        android:background="@drawable/btn_bg_today_dialog"
                        android:text="@string/cancel_text"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:visibility="visible" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/add_btn_video_ads"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_37sdp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_7sdp"
                        android:layout_weight="50"
                        android:background="@drawable/btn_bg_today_dialog"
                        android:paddingLeft="50dp"
                        android:paddingRight="50dp"
                        android:text="Yes"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />


                </LinearLayout>


            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_75sdp"
            android:layout_height="@dimen/_75sdp"
            android:layout_above="@+id/cardBottom"
            android:layout_centerInParent="true"
            android:layout_marginBottom="-40dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_45sdp"
            app:cardElevation="5dp">


            <ImageView
                android:id="@+id/points_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:minWidth="100dp"
                android:src="@drawable/ic_playtime" />

        </androidx.cardview.widget.CardView>

    </RelativeLayout>
</RelativeLayout>