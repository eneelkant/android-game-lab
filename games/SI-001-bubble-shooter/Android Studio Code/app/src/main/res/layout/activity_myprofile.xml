                            android:layout_marginRight="40dp"
                            app:srcCompat="@drawable/send_ic"
                            app:tint="#E91E63" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
