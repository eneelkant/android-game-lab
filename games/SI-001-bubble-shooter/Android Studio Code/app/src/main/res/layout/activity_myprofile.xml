                        android:layout_gravity="center"
                        android:gravity="right">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginRight="40dp"
                            app:srcCompat="@drawable/send_ic"
                            app:tint="#9C27B0" />
