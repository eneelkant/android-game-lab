            android:layout_width="0.0dip"
            android:layout_height="88.0dip"
            android:layout_marginStart="20.0dip"
            android:layout_marginTop="32.0dip"
            android:layout_marginEnd="10.0dip"
            android:background="@drawable/background_card_16dp_yellow"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toStartOf="@+id/constraintLayout9"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/userpp">

            <ImageView
                android:id="@+id/imageView16"
                android:layout_width="50.0dip"
                android:layout_height="50.0dip"
                android:layout_marginTop="16.0dip"
                android:layout_marginEnd="16.0dip"
                android:layout_marginBottom="16.0dip"
                android:src="@drawable/ic_coin_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16.0dip"
                android:layout_marginTop="16.0dip"
                android:fontFamily="@font/poppins_bold"
                android:text="00"
                android:textColor="@color/yellow"
                android:textSize="24.0sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView31"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16.0dip"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/Total_Earn"
                android:textColor="@color/yellow"
                android:textSize="14.0sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/textView30" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/constraintLayout9"
            android:layout_width="0.0dip"
            android:layout_height="88.0dip"
            android:layout_marginStart="10.0dip"
            android:layout_marginEnd="20.0dip"
            android:background="@drawable/background_card_16dp_yellow"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@id/constraintLayout10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@id/constraintLayout10"
            app:layout_constraintTop_toTopOf="@id/constraintLayout10">

